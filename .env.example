# CardGoblin configuration template (copy to .env.local).
# Development defaults to local-only mode: no account, sign-in, or network
# connection is needed. Set the mode to cloud only when intentionally testing
# the existing cloud feature. Every cloud var is server-side —
# none is prefixed NEXT_PUBLIC_, so none can reach the browser bundle.
#
# These same values go in Vercel (Project → Settings → Environment
# Variables) too. Full runbook: docs/deployment.md
#
# Restart `npm run dev` after editing — Next reads env at boot.

# Optional. Values other than `cloud` use local-only mode.
NEXT_PUBLIC_CARDGOBLIN_MODE=local

# --- Cloudflare R2 (Dashboard → R2 → your bucket / Manage API Tokens) --------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=cardgoblin

# --- Admin sign-in ----------------------------------------------------------
# NOT your password — the scrypt hash of it. Generate with:
#     npm run hash-password
# then paste the whole scrypt.... string it prints, verbatim — no escaping
# or quoting needed anywhere (the dot-separated format is dotenv-safe by
# construction). Your actual password never touches disk, git, or this file;
# you type it at the sign-in dialog.
ADMIN_PASSWORD_HASH=

# Optional — the sign-in username, paired with the password above. Unset (or
# blank) defaults to "admin"; set it to something non-obvious if you'd rather
# a credential-stuffing bot not get to assume the username for free.
# ADMIN_USERNAME=admin

# Signs the session cookie. Anyone holding this can forge a session, so treat
# it like a password. At least 32 characters (the server refuses shorter).
#     openssl rand -base64 32
SESSION_SECRET=
