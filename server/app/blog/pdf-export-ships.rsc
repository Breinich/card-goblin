1d:["$","p","p-2",{"className":"my-4","children":[["$","strong","strong-0",{"className":"font-semibold text-gray-100","children":"Duplex backs line up."}]," Choose duplex and every page of fronts is followed by\nits backs with the columns mirrored, which is what makes double-sided printing\nalign when your printer flips on the long edge. Get this wrong and you discover\nit after cutting."]}]
1e:["$","p","p-3",{"className":"my-4","children":[["$","strong","strong-0",{"className":"font-semibold text-gray-100","children":"What you see is what prints."}]," Each distinct card face is rendered at 300 DPI\nthrough the browser's own renderer, so fonts and icon ligatures come out exactly\nas they look in the preview. Identical faces are rendered once and reused, so a\n",["$","code","code-0",{"className":"rounded bg-gray-800 px-1.5 py-0.5 font-mono text-[13px] text-teal-300","children":"count: 10"}]," card doesn't cost ten renders."]}]
1f:["$","p","p-4",{"className":"my-4","children":[["$","strong","strong-0",{"className":"font-semibold text-gray-100","children":"Cards are exact millimetres."}]," The unit grid maps to real physical sizes, so a\npoker card comes out 63.5 × 88.9 mm — not \"about right\"."]}]
20:["$","p","p-5",{"className":"my-4","children":[["$","strong","strong-0",{"className":"font-semibold text-gray-100","children":"Broken cards are skipped, and you're told first."}]," If any card is an error\nplaceholder, the modal warns you how many before you export rather than\nsilently printing a grey rectangle."]}]
